# Local API (the local compose.yml starts PostgreSQL on localhost:5432)
APP_ENV=development
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
PORT=BE-port

JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=frontend-url

# Production API on Render: use the Supabase pooler URI with sslmode=require.
# APP_ENV=production
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:<port>/postgres?sslmode=require
# JWT_SECRET=<strong-random-secret>
# ALLOWED_ORIGINS=https://<your-custom-domain>
# INITIAL_ADMIN_EMAIL=<admin-email>
# INITIAL_ADMIN_PASSWORD=<strong-one-time-password>
